  "reference": {
    "u": "sin(x) * cos(y) * exp(-2*nu*t)",
    "v": "-cos(x) * sin(y) * exp(-2*nu*t)"
  },
  "validation": {
    "l2_tolerance": 0.0002,
    "max_tolerance": 0.0004
  }
}